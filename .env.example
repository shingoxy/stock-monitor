# 数据库配置
DATABASE_URL=sqlite:///./stock_monitor.db
# DATABASE_URL=postgresql://user:password@localhost:5432/stock_monitor

# 日志级别
LOG_LEVEL=INFO

# 数据源配置
# 东财限流间隔(秒)，批量任务建议调大到 1.5-2.0
EM_MIN_INTERVAL=1.0

# 北交所股票是否纳入（默认关闭）
INCLUDE_BJ_EXCHANGE=false

# 最低市值过滤(元)，默认50亿
MIN_MARKET_CAP=5000000000

# 最低股息率过滤(%)
MIN_DIVIDEND_YIELD=1.0

# 股息率计算默认口径: ttm / annual / forward
DEFAULT_YIELD_METHOD=ttm

# Optional MCP credentials are deliberately not used by the authoritative
# database synchronization path. If exploratory MCP scripts are added later,
# keep credentials in the local .env only and never commit them.
# IFIND_AUTHORIZATION=
# FUYAO_API_KEY=
